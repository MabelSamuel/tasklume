generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ── Identity ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  roles         UserRole[]
  tier          String    @default("free")
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferences         UserPreferences?
  projects            Project[]
  tasks               Task[]
  taskDrafts          TaskDraft[]
  prioritySuggestions PrioritySuggestion[]
  digests             Digest[]
  usageLogs           UsageLog[]
  refreshTokens       RefreshToken[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // SHA-256 hash, never the raw token
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Per-user knobs the AI reads. Goals and project weights are how users
// correct prioritization bias instead of trusting a fixed formula.
model UserPreferences {
  userId          String   @id
  timezone        String   @default("UTC")   // IANA name, e.g. 'Africa/Lagos'
  goals           String?                     // Free text fed to the prioritizer
  projectWeights  Json     @default("{}")     // { [projectId]: 0.5..2 } multiplier
  dailyDigest     Boolean  @default(true)
  weeklyDigest    Boolean  @default(true)
  digestHour      Int      @default(8)        // Local hour (0-23) digests are generated
  weeklyDigestDay Int      @default(1)        // 0 = Sunday ... 6 = Saturday
  autoConfirmCapture Boolean @default(false) // Skip the draft review on high-confidence parses
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── RBAC ──────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique   // 'admin', 'member', 'viewer'
  description String?
  isDefault   Boolean  @default(false)  // New users get this role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique   // 'tasks:create'
  description String?
  resource    String              // 'tasks'
  action      String              // 'create'
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@unique([resource, action])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?  // Who assigned this role (for audit)

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ── Tasks ─────────────────────────────────────────────

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?   // Helps the categorizer decide what belongs here
  color       String?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  description   String?
  status        TaskStatus   @default(todo)
  priority      TaskPriority @default(medium)
  dueDate       DateTime?
  tags          String[]     @default([])
  completedAt   DateTime?

  // Provenance: lets the UI show what the AI decided so the user can override it
  source        String       @default("manual") // manual | capture | assistant
  prioritySetBy String       @default("user")   // user | ai
  projectSetBy  String?                          // user | ai (null = no project)

  // Background enrichment (embedding + auto-categorization)
  enrichmentStatus String    @default("pending") // pending | processing | ready | failed | skipped (AI off)
  enrichmentError  String?
  embedding     Unsupported("vector(1536)")?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  draft   TaskDraft?

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId])
}

// The AI's reading of a natural-language capture, held for the user to
// confirm or edit before it becomes a Task. Comparing `parsed` with what the
// user confirmed is how parse accuracy is measured.
model TaskDraft {
  id              String    @id @default(cuid())
  userId          String
  rawInput        String
  parsed          Json      // { title, description, dueDate, priority, projectId, tags }
  confidence      Float
  ambiguities     String[]  @default([])  // What the AI was unsure about, shown to the user
  status          String    @default("pending") // pending | confirmed | discarded
  model           String                         // 'rules' when the AI fallback parser was used
  fallbackUsed    Boolean   @default(false)
  correctedFields String[]  @default([])         // Fields the user changed on confirm
  taskId          String?   @unique
  correlationId   String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

// A ranked recommendation. Never applied automatically: the user accepts
// all or part of it, or dismisses it.
model PrioritySuggestion {
  id           String    @id @default(cuid())
  userId       String
  items        Json      // [{ taskId, rank, suggestedPriority, currentPriority, reason }]
  summary      String
  status       String    @default("pending") // pending | accepted | partially_accepted | dismissed
  acceptedIds  String[]  @default([])
  model        String
  fallbackUsed Boolean   @default(false)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Digest {
  id           String   @id @default(cuid())
  userId       String
  period       String   // daily | weekly
  periodKey    String   // '2026-11-02' (daily) or '2026-W45' (weekly), in the user's timezone
  summary      String
  stats        Json     // { overdue, dueToday, dueThisWeek, atRisk, completed, ... }
  highlights   Json     // { overdue: [...], atRisk: [...], upcoming: [...] } task snapshots
  model        String
  fallbackUsed Boolean  @default(false)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One digest per user per period: makes the scheduled job idempotent
  @@unique([userId, period, periodKey])
  @@index([userId, createdAt])
}

// ── AI gateway ───────────────────────────────────────

model PromptTemplate {
  id        String   @id @default(uuid())
  taskType  String               // 'capture', 'categorize', 'prioritize', 'digest', 'agent'
  version   String               // 'v1', 'v2', 'v3'
  name      String               // Human-readable name
  content   String               // The actual prompt text
  isActive  Boolean  @default(false)
  metadata  String?              // JSON: notes, author, changelog
  createdAt DateTime @default(now())

  @@unique([taskType, version])
  @@index([taskType, isActive])
}

model AIAuditLog {
  id             String   @id @default(uuid())
  userId         String
  correlationId  String
  taskType       String
  model          String
  promptVersion  String
  inputTokens    Int
  outputTokens   Int
  costUsd        Float
  latencyMs      Int
  fallbackUsed   Boolean  @default(false)
  // First 500 chars only, and '[redacted]' unless AI_AUDIT_LOG_CONTENT=true
  inputSummary   String
  outputSummary  String
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([taskType, createdAt])
  @@index([model, createdAt])
}

// ── Audit / integrations ─────────────────────────────

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  tokens    Int      @default(0)
  costUsd   Float    @default(0)
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
}

model WebhookEvent {
  id           String    @id  // The provider's event ID
  provider     String          // 'stripe', 'github', etc.
  eventType    String          // 'payment.succeeded', etc.
  receivedAt   DateTime  @default(now())
  processedAt  DateTime?
  payload      String          // Raw payload for debugging

  @@index([provider, eventType])
}
