# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Database (needs the pgvector extension; docker-compose uses pgvector/pgvector:pg16)
DATABASE_URL=postgresql://tasklume:tasklume@localhost:5432/tasklume

# Authentication (each secret must be at least 32 characters and they must differ;
# generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-random-string-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (cache, rate limiting, BullMQ)
REDIS_URL=redis://localhost:6379

# Webhooks (HMAC-SHA256 shared secret; webhooks return 503 until set)
WEBHOOK_SECRET=

# External HTTP API (optional; used by src/lib/http/external.*)
EXTERNAL_API_BASE_URL=
EXTERNAL_API_KEY=

# AI provider: gemini (default) or openai. Leave the key empty to run with
# AI off: capture uses the rules parser, prioritization the heuristic score,
# digests a template, search falls back to keywords; the assistant returns 503.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Privacy: keep 500-char prompt/response excerpts in AIAuditLog (false = '[redacted]')
AI_AUDIT_LOG_CONTENT=false

# Capture: auto-confirm threshold (only for users with autoConfirmCapture on)
CAPTURE_AUTO_CONFIRM_MIN_CONFIDENCE=0.85
# Auto-categorization: below this confidence the task is left without a project
CATEGORIZE_MIN_CONFIDENCE=0.7

# Hourly digest scheduler (worker process)
DIGESTS_ENABLED=true
